# Copia in .env.local e riempi: .env.local non finisce su git.
# URL e chiave sono in Supabase → Project Settings → API Keys. La chiave
# publishable (o la vecchia anon) è pubblica per progettazione: i dati li
# proteggono le policy del database, non il segreto della chiave.
# Sviluppo e produzione usano lo stesso progetto: i dati sono gli stessi.

VITE_SUPABASE_URL=https://<riferimento-progetto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# L'email dell'unico account (Authentication → Users): chi entra scrive solo la
# passphrase, che è la password di questo account.
VITE_SUPABASE_EMAIL=
